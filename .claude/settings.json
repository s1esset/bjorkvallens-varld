{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": false,
    "game-development@claude-code-workflows": true,
    "pixijs-skills@pixijs-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "HermeticOrmus/claude-code-game-development"
      }
    },
    "pixijs-skills": {
      "source": {
        "source": "github",
        "repo": "pixijs/pixijs-skills"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-start.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run backup*)",
      "Bash(node scripts/check.mjs*)",
      "Bash(node scripts/test-game.mjs*)",
      "Bash(node scripts/test-games.mjs*)",
      "Bash(node scripts/korning.mjs*)",
      "Bash(node scripts/session-start.mjs*)"
    ]
  }
}
