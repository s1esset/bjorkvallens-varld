{
  "name": "bjorkvallens-varld",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Björkvallens Värld — PWA med roliga, lärorika minispel för barn 2–5 år (svenska, offline, ingen reklam)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "serve:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test-games.mjs",
    "test:all": "node scripts/test-games.mjs --all",
    "test:fx": "node scripts/test-feedback.mjs",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "icons": "node scripts/generate-icons.mjs",
    "assets": "node scripts/fetch-fonts.mjs",
    "voice": "\"C:/repos/storygen/services/narrator/.venv/Scripts/python.exe\" scripts/gen-voice.py --phrases scripts/voice-phrases.json --ref \"C:/repos/storygen/services/narrator/src/narrator/assets/narrator_default.wav\" --ref-text \"Some call me nature, others call me mother nature.\" --out public/audio/voice",
    "sfx": "\"C:/repos/storygen/services/narrator/.venv/Scripts/python.exe\" scripts/gen-sfx.py"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.6.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.61.1",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
